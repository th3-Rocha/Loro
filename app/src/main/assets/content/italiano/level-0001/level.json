        { "text": "Tu sei italiano.", "translation": "Você é italiano." },
        { "text": "Lui è di Roma.", "translation": "Ele é de Roma." },
        { "text": "Lei è di Milano.", "translation": "Ela é de Milão." }
      ]
    },
